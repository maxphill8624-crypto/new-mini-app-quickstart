# Polymarket Insider Trading Detector - Environment Configuration

# PolygonScan API Key (get free key from https://polygonscan.com/apis)
# This is used to check wallet age and transaction history on Polygon blockchain
POLYGONSCAN_API_KEY=YourApiKeyToken

# Email Alert Configuration (Optional)
# Set these if you want to receive email alerts
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_PASSWORD=your-app-specific-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Note: For Gmail, you need to use an "App Password" not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
